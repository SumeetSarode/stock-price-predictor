# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.github/instructions/wmt-copilot.instructions.md

# Secrets / env
.env

# Data — never commit (PII, large files, regenerable)
data/cache/
data/kb/*
# ...except the canonical stock registry, which we DO commit so a fresh
# clone has working data without re-running the bootstrap script.
!data/kb/stocks.json
!data/kb/indices.json
!data/kb/index_membership.json
data/logs/*.log
data/logs/*.log.gz
data/outputs/*.json
data/predictions/
data/*.sqlite
data/*.sqlite-journal

# Coverage / test artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml
.pytest_cache/

# Tooling caches
.ruff_cache/
.mypy_cache/

# Backups / OS / IDE
requirements.txt.bak
.DS_Store
.idea/
.vscode/
*.swp
.adk/
reports/

# Smoke-test transcripts (transient; regenerated on each run)
scripts/smoke_chain_output.txt

# Diagnostic runs: ignore the many timestamped ones, but ALLOW latest.* so
# the user can commit+push a single result file for review.
diagnostics/diag_*
!diagnostics/latest.txt
!diagnostics/latest.json
diagnostics/free_tier_test_*
!diagnostics/free_tier_test_latest.txt

# scripts/bench_ollama_configs.py output -- one timestamped file per manual
# run, never auto-generated (not wired into launch.bat). Transient, no
# 'latest' variant needed since these are one-off measurement runs.
diagnostics/ollama_bench_*
