# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.github/instructions/wmt-copilot.instructions.md

# Secrets / env
.env
# ...and every variant: .env.local, .env.bak, .env.backup_*, .env.20260813 etc.
# A bare '.env' does NOT cover these, and they hold the same real keys.
# (.env.example is force-kept below -- it's the template, no secrets.)
.env.*
!.env.example

# Data — never commit (PII, large files, regenerable)
data/cache/
data/kb/*
# ...except the canonical stock registry, which we DO commit so a fresh
# clone has working data without re-running the bootstrap script.
!data/kb/stocks.json
!data/kb/indices.json
!data/kb/index_membership.json
data/logs/*.log
data/logs/*.log.gz
data/outputs/*.json
data/predictions/
data/*.sqlite
data/*.sqlite-journal

# Coverage / test artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml
.pytest_cache/

# Tooling caches
.ruff_cache/
.mypy_cache/

# Backups / OS / IDE
requirements.txt.bak
.DS_Store
.idea/
.vscode/
*.swp
.adk/
reports/

# Smoke-test transcripts (transient; regenerated on each run)
scripts/smoke_chain_output.txt
