# ── LLM API keys ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# ── Model selection: profile-based fallback chains ─────────────────
# Each profile = an ordered free-tier fallback chain + paid override.
# Agents pick a profile via make_resilient_model(profile="agentic").
# Avoid reasoning models (e.g. gpt-oss-120b) here — reasoning_content
# in assistant messages breaks Groq's multi-turn input validator.
# Gemini first: best ADK function-call compatibility (handles thought+call turns).
# Groq models (llama-3.3-70b, gpt-oss-120b) reject the assistant message shape
# that ADK builds on multi-turn tool conversations -- kept as last-resort fallback.
CHAIN_AGENTIC=gemini/gemini-2.5-flash,gemini/gemini-2.5-flash-lite,groq/openai/gpt-oss-120b
PAID_AGENTIC=groq/llama-3.3-70b-versatile

# Toggle to switch ALL agents from free chain → paid override
USE_PAID=false

# ── Price-data provider chain (parallels the LLM chain pattern above) ───
# Each name is a short id registered in data/providers/__init__.py.
# Currently registered: yfinance, stooq, alpha_vantage.
#
# Cost / reliability profile:
#   yfinance       — free, no key, but Yahoo throttles aggressively
#   stooq          — free, no key, daily-only, very stable, slower data refresh
#   alpha_vantage  — free tier 25 req/day, needs key. Paid tier ~$50/mo lifts that.
PRICE_CHAIN=yfinance,stooq,alpha_vantage

# PRICE_PAID = single-provider override used when USE_PAID_PRICES=true.
PRICE_PAID=alpha_vantage

# Toggle: set true to bypass the free chain and use PRICE_PAID directly.
USE_PAID_PRICES=false

# Required ONLY if 'alpha_vantage' appears in PRICE_CHAIN or PRICE_PAID.
# Get a free key at https://www.alphavantage.co/support/#api-key
# Leave EMPTY (or remove the var) if you never use AlphaVantage.
ALPHA_VANTAGE_API_KEY=

# Required ONLY if 'stooq' appears in PRICE_CHAIN.
# Stooq added an apikey requirement in 2024 -- still free, just one-time captcha.
# Get one at: https://stooq.com/q/d/?s=aapl.us&get_apikey  (solve captcha, copy key)
STOOQ_API_KEY=

# ── Runtime defaults (override if you want) ──────────────
PREDICTOR_LOG_LEVEL=INFO
PREDICTOR_DATA_DIR=./data

# ── Walmart corp network ONLY (uncomment if you're behind sysproxy) ────────
# Off-corp default: leave commented. yfinance / Stooq / AV reach the public
# internet directly from home / coffee shop / mobile hotspot — no proxy needed.
#
# On Walmart: api.groq.com etc. don't resolve directly. Uncomment so HTTP
# libraries (httpx, aiohttp via LiteLLM) tunnel through the corp proxy.
# proxy-intlho is the no-auth external proxy from the Walmart PAC file.
#HTTPS_PROXY=http://proxy-intlho.wal-mart.com:8080
#HTTP_PROXY=http://proxy-intlho.wal-mart.com:8080
#NO_PROXY=localhost,127.0.0.1,.wal-mart.com,.walmart.com

# SSL trust: Walmart proxy MITMs HTTPS with a self-signed root, so we need
# a combined CA bundle (certifi public + Walmart corp).
# Generate it with: ./scripts/build_ca_bundle.sh
# Then UNCOMMENT and set BOTH vars to the absolute path it printed.
# Off-corp: leave commented — Python falls back to certifi (the system default).
#SSL_CERT_FILE=/absolute/path/to/price_predictor/certs/ca-bundle.pem
#REQUESTS_CA_BUNDLE=/absolute/path/to/price_predictor/certs/ca-bundle.pem
