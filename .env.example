# ── LLM API keys ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# ── OPTIONAL: candidate-provider evaluation key ──────────────────
# NOT part of CHAIN_AGENTIC / the actual app -- consumed only by
# scripts/test_free_tier_access.py, which launch.bat runs every launch to
# empirically prove Nemotron-3-Ultra:free (via OpenRouter) still has free
# access before we'd ever depend on it in the real chain. Leave blank/unset
# to skip the test entirely (zero cost, near-instant).
#
# GLM-5.2 was evaluated the same way and dropped: confirmed, three
# independent ways, to have no free API access anywhere (Zenmux's "-free"
# slug redirects to the paid model, Zenmux's own docs say free = Studio
# Chat only, and Zhipu's own api.z.ai returned "Insufficient balance" on a
# live call). Not revisiting unless a genuinely new free path turns up.
OPENROUTER_API_KEY=

# ── Model selection: profile-based fallback chains ───────────────
# Each profile = an ordered free-tier fallback chain + paid override.
# Agents pick a profile via make_resilient_model(profile="agentic").
# Avoid reasoning models (e.g. gpt-oss-120b) here — reasoning_content
# in assistant messages breaks Groq's multi-turn input validator.
# Gemini first: best ADK function-call compatibility (handles thought+call turns).
# Groq models (llama-3.3-70b, gpt-oss-120b) reject the assistant message shape
# that ADK builds on multi-turn tool conversations -- kept as last-resort fallback.
#
# CHAIN DIVERSITY RULE: never put two models from the same provider back-to-back
# in the chain. Both gemini-2.5-flash and gemini-2.5-flash-lite share the same
# Google project quota — falling from one to the other gives ZERO real fallback.
# Always alternate providers so each fallback hop lands in a fresh quota bucket.
#
# OFFLINE TAIL (optional): append a local Ollama model as the LAST entry so
# that when EVERY hosted provider (Gemini + Groq) is rate-limited, the chain
# drops to a local model with no quota. Requires Ollama running + the model
# pulled: `ollama pull qwen3:8b`. Remove it if you don't run Ollama.
CHAIN_AGENTIC=gemini/gemini-flash-latest,groq/openai/gpt-oss-120b,groq/llama-3.3-70b-versatile,ollama_chat/qwen3:8b
PAID_AGENTIC=groq/llama-3.3-70b-versatile

# Toggle to switch ALL agents from free chain → paid override
USE_PAID=false

# Local Ollama server URL (only used if an 'ollama_chat/*' entry is in a chain).
OLLAMA_API_BASE=http://localhost:11434

# Ollama context window (tokens). Ollama defaults this to only 2048 no
# matter the model's real capacity, so big prediction prompts fail with a
# ContextWindowExceededError (surfaced as an LLM token limit error).
# 16384 fits the prompt + reasoning with headroom. Raise only if you see a
# token-limit error; lower if RAM/VRAM constrained.
OLLAMA_NUM_CTX=16384

# Ollama reasoning effort -> mapped to the `think` flag by litellm.
# For qwen3, litellm treats low/medium/high IDENTICALLY (all -> think=True);
# any OTHER value (e.g. "none") -> think=False (thinking OFF, much faster).
# Default "high" keeps reasoning ON for prediction quality. Only set to
# "none" after scripts/bench_ollama_configs.py proves accuracy holds.
OLLAMA_REASONING_EFFORT=high

# ── Per-provider request rate limits (proactive pacing) ────────────────
# The llm.rate_limiter module paces requests BEFORE they hit the provider
# so batch workloads don't blow the free-tier RPM in their first burst.
# Defaults sit just below each provider's published free-tier ceiling.
# Set any value to 0 to disable that specific limit (RPM or RPD).
#
# Free-tier reference (subject to change by providers):
#   Gemini 2.5 Flash: 10 RPM, 250 RPD per Google project
#   Groq (most free): 30 RPM, 14400 RPD per Groq account
#
# Adjust UPWARD if you have a higher quota; adjust DOWNWARD if you share the
# API key with other tools (Code Puppy, gcloud, etc.) that also burn quota.
GEMINI_RPM=9
GEMINI_RPD=240
GROQ_RPM=28
GROQ_RPD=14000

# Paid-tier overrides (used only when USE_PAID=true). 0 = unlimited.
# Most paid plans have no meaningful request-count limit — leave at 0
# unless you've configured a specific tier-cap to stay under.
GEMINI_RPM_PAID=0
GEMINI_RPD_PAID=0
GROQ_RPM_PAID=0
GROQ_RPD_PAID=0

# Pacing sleep cap (seconds). The per-minute limiter normally SLEEPS until a
# slot frees up. For a single interactive prediction a long sleep looks like
# a hang -- with this cap, if the required wait exceeds it the limiter instead
# raises a rate-limit error so the chain falls over to the next model (e.g.
# Groq saturated -> Gemini or the local Ollama tail) rather than blocking.
# 0 = never cap (always sleep; original behavior). Default 10s absorbs normal
# pacing jitter but bails fast when a provider is saturated for a full window.
PACING_MAX_SLEEP_S=10

# ── News RSS live fallback ─────────────────────────────────────────────
# GDELT (the primary news source) is keyless + IP-rate-limited (~1 req/5s),
# so bursts return 429 and a run loses its news. When GDELT fails, fall back
# to Google News RSS (live-only, great India coverage, no key).
# CRITICAL: RSS returns RECENT news only, so it is used ONLY when the query
# window ends within NEWS_RSS_FRESHNESS_DAYS of now -- NEVER for backtests
# (serving 'current' news for a past date would be look-ahead contamination).
# GDELT stays the sole historical source. Set enabled=false for GDELT-only.
NEWS_RSS_FALLBACK_ENABLED=true
NEWS_RSS_FRESHNESS_DAYS=30

# GDELT retry patience. On a 429/network blip GDELT retries with linear
# backoff before giving up (429: 5s,10s; network: 2s,4s). For LIVE predictions
# the snapshot layer OVERRIDES these to 0 when RSS can catch us -- so a 429
# falls over to RSS in <1s instead of sleeping ~15s. These values still apply
# to backtests (RSS-forbidden by the look-ahead guard). Lower = less patient.
GDELT_RATE_LIMIT_RETRIES=2
GDELT_NETWORK_RETRIES=2

# ── Price-data provider chain (parallels the LLM chain pattern above) ───
# Each name is a short id registered in data/providers/__init__.py.
# Currently registered: jugaad, nse_bhavcopy, yfinance, stooq, alpha_vantage.
#
# Cost / reliability profile (per pred_logic_solutions.md C1 scorecard):
#   jugaad        — free, NSE-native (jugaad-data lib). PRIMARY tier for India.
#                   Pulls from NSE's own historical-trade endpoints. Auto-throttled,
#                   per-year batched, locally cached. No key required.
#   nse_bhavcopy  — free, exchange-of-record EOD CSV. SECONDARY tier. One HTTP call
#                   per trading day; great for short windows + universe backfills,
#                   slow for many-year per-symbol fetches. Auto-routes legacy
#                   (pre-2024-07-08) and UDiff (>=2024-07-08) formats.
#   yfinance      — free, no key, but Yahoo throttles aggressively + breaks ~2x/yr
#                   when their HTML changes. FALLBACK tier — the safety net.
#   stooq         — free, captcha-key. ⚠ NO NSE/BSE COVERAGE (verified empirically
#                   2026-04-28: stooq.com/q/?s=reliance.in returns empty body;
#                   AAPL.US works fine). Class kept for non-NSE use; do NOT include
#                   in PRICE_CHAIN for Indian equities — pure dead weight + latency.
#   alpha_vantage — free tier ONLY 25 requests/day per key (per AV docs at
#                   https://www.alphavantage.co/support/#support). Paid Premium
#                   plans start at $49.99/mo (75 req/min) and go up to $249.99/mo
#                   (1200 req/min). NSE feed has known reliability issues per
#                   pred_logic_solutions.md — OMITTED from default chain. Add it
#                   manually only if you specifically want it.
#
# Default chain: jugaad → nse_bhavcopy → yfinance. Each tier falls back on the
# next when the previous returns PriceFetchError.
#
#  RUNNING OUTSIDE INDIA (USA/EU/etc.)? NSE (nseindia.com) geo-blocks foreign
#   IPs — BOTH jugaad and nse_bhavcopy hit NSE and will fail with 403/timeout.
#   The chain still works (it falls back to yfinance), but it wastes 1-2 MINUTES
#   per fetch dying on the two dead NSE tiers first. On any non-India laptop, set:
#       PRICE_CHAIN=yfinance
#   This skips the blocked tiers → data fetch drops from minutes to ~2s, and the
#   'access denied' log noise disappears. Keep the NSE-first chain ONLY for
#   India deployments, where bhavcopy is the authoritative exchange-of-record.
PRICE_CHAIN=jugaad,nse_bhavcopy,yfinance

# PRICE_PAID = single-provider override used when USE_PAID_PRICES=true.
# Default to 'jugaad' as the single most reliable NSE source. There's no
# real paid provider in the registry yet (Kite/Upstox integration is H1-tier,
# deferred). When that ships, switch this to 'kite' or 'upstox'.
PRICE_PAID=jugaad

# Toggle: set true to bypass the free chain and use PRICE_PAID directly.
USE_PAID_PRICES=false

# Required ONLY if 'alpha_vantage' appears in PRICE_CHAIN or PRICE_PAID.
# Get a free key at https://www.alphavantage.co/support/#api-key
# Leave EMPTY (or remove the var) if you never use AlphaVantage.
# NOTE: AV is no longer in the default chain (NSE feed unreliable, 25/day
# limit too tight). Only set this if you've added 'alpha_vantage' back
# to PRICE_CHAIN explicitly.
ALPHA_VANTAGE_API_KEY=

# Required ONLY if 'stooq' appears in PRICE_CHAIN. Note: Stooq has NO NSE
# coverage (see comment above). The provider class is kept registered for
# non-Indian use cases (US, EU, JP, HK equities all work) but is NOT in the
# default chain. Add it back manually only if you fetch non-Indian tickers.
# Get a key at: https://stooq.com/q/d/?s=aapl.us&get_apikey  (solve captcha)
STOOQ_API_KEY=

# ── Runtime defaults (override if you want) ──────────────
PREDICTOR_LOG_LEVEL=INFO
PREDICTOR_DATA_DIR=./data

# ── Network / proxy (optional — only if behind an HTTP proxy) ─────────
# Leave commented for normal home/personal networks. If you're behind a
# proxy, uncomment so HTTP libraries (httpx, aiohttp via LiteLLM) tunnel
# through it.
#HTTPS_PROXY=http://your-proxy:8080
#HTTP_PROXY=http://your-proxy:8080
#NO_PROXY=localhost,127.0.0.1

# SSL trust: only needed behind a TLS-inspecting proxy that re-signs HTTPS
# with a custom root CA. Point both at a combined certifi+custom bundle.
# Leave commented otherwise — Python falls back to certifi (the default).
#SSL_CERT_FILE=/absolute/path/to/ca-bundle.pem
#REQUESTS_CA_BUNDLE=/absolute/path/to/ca-bundle.pem
